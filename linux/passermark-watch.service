# Passermark Watcher (Drop-Ordner) als Systemdienst – mit eigenem Benutzer ohne besondere Rechte.
#
# install.sh richtet alles ein. Von Hand (einmal, als root):
#   passermark-cli shared-folder            gemeinsamer Druckordner /srv/passermark, Gruppe passermark
#   useradd --system -g passermark --home-dir /var/lib/passermark --shell /usr/sbin/nologin passermark
#   cp passermark-watch.service /etc/systemd/system/
#   Einstellung anlegen: /etc/passermark/watch.json  (prüfen: passermark-cli serve --check)
#   Drop-Ordner unter /srv/passermark/hotfolder – Ordner in /home sind für den Dienst gesperrt (ProtectHome)
#   systemctl daemon-reload && systemctl enable --now passermark-watch
#   Protokoll: journalctl -u passermark-watch -f
#
# AppImage statt install.sh: ExecStart auf  /pfad/Passermark.AppImage --cli serve …  ändern.
[Unit]
Description=Passermark Watcher (drop folders -> workflows)
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=passermark
Group=passermark
UMask=0007
ExecStart=/usr/local/bin/passermark-cli serve --config /etc/passermark/watch.json
Restart=on-failure
RestartSec=10
StateDirectory=passermark
Environment=HOME=/var/lib/passermark
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
